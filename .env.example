PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=
PGPASSWORD=
PGSSLMODE=verify-full
# Optional Cloud SQL Connector for instances with Public IP.
# CLOUD_SQL_INSTANCE_CONNECTION_NAME=project:region:instance
# CLOUD_SQL_CREDENTIALS_JSON=
# Optional CA from the DB operator. Leave unset for a publicly trusted CA.
# PGSSLROOTCERT=C:/path/to/postgres-ca.pem
# PG_TLS_PIN_FILE=C:/path/to/postgres-server.pem
APP_SECRET=
# Must use a stable, shared secret for persisted phone lookup and ciphertext.
# SMS_WEBHOOK_URL=https://sms-provider.example/send
# SMS_WEBHOOK_TOKEN=
# DEV_SMS=1
# DEV_SKIP_SIGNUP_SMS=1
# OCR_LANG=eng+kor
# COOKIE_SECURE=1
# APP_ORIGIN=https://app.example
# BIND_HOST=127.0.0.1
# PORT=3000

